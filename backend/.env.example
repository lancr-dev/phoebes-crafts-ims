# Copy to .env locally. Use protected environment settings in production.
NODE_ENV=development
PORT=5001
FRONTEND_ORIGIN=http://localhost:5173

# Backend-only credentials. Never put these in VITE_ variables.
MONGO_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_USERNAME=

# Store the scrypt hash, not a plaintext password.
# Required format: scrypt$32768$8$3$<32 hexadecimal salt characters>$<128 hexadecimal hash characters>
ADMIN_PASSWORD_HASH=
